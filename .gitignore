# Dependencies
node_modules

# Build
dist
*.local

# Env (never commit secrets — only public anon key allowed)
.env
.env.*.local

# Logs / cache
npm-debug.log*
.DS_Store
coverage
.vitest

# Editor
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# PWA dev
dev-dist

# Playwright / coverage (artefacts générés)
/playwright-report/
/test-results/
/blob-report/
/coverage/

# Types Supabase générés localement (`npm run gen:types`) — comparer avec src/types/database.ts
src/types/database.gen.ts

# Lighthouse CI (rapports locaux)
.lighthouseci/

# Copies complètes du dépôt, créées par les agents lancés en `isolation:
# worktree`. Elles étaient masquées par `.git/info/exclude`, qui est LOCAL :
# invisible à `git status` ici, absent partout ailleurs. Versionnée, la ligne
# couvre aussi Prettier, qui honore `.gitignore` depuis la 3.x.
.claude/worktrees/
